#
#  Test if everything works from "bigroo"
#  clone, edit, gitt add, commit and push:
#
    gh auht status              
    gh auth setup-git    # this is just to make sure that https authjentication works  OK

    git clone https://github.com/jjakowski/sandbox.git        # c
    
    cd sandbox 
    vi README.md 
    git add  README.md  
    git status        # shows which files are edited (in  green are staged for upload with 'git add', in  red are  not staged)
    git commit  -m "Edits from bigroo"
    git push     
     
    # You can now check  https://github.com/jjakowski/sandbox/README.md has been edited (added a  line:  "Bigroo: ubuntu"   


