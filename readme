#
# Create a new rep 'sandbox' on github.com
#

  gh repo create sandbox --public --clone --description "Tiny cross-machine Git testbed"

     # * Creates a new public repo on GitHub called sandbox
     # *  Adds the provided description
     # * Clones it locally (because of '--clone')
  
#
#  Create a  .gitignore file for a mixed C/Python project, telling Git to skip typical junk and environment-specific files.  
#
  cd sandox 
  vi .gitignore
          #(base) j2c@jackaroo:~/Development/sandbox$ cat .gitignore 
           *.o
           build/
          .DS_Store
          .vscode/
          __pycache__/
      
  
#
#  edit some project files  
#
  vi README.md
  vi hello.py
  vi hello.cpp

#
# upload  the edited files to github with 'git add, commit and push'
# (session on jackaroo from homenetwork)
# 
  git add README.md hello.py hello.cpp  # add specific files 
                                        # `git add .` would add all files
  git commit -m "quick update from jackaroo"
 
  git push -u origin main               # upload my local 'main' branch  to 'origin' at github.com

  git branch                            # list available brnaches and shows whihc is currently working branch
  git branch -vv                        # same as above but shows more info

   # example session:
      (base) j2c@jackaroo:~/Development/sandbox$ git add .
